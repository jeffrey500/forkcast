# Required in production: long random string used to sign login sessions.
AUTH_SECRET=
# Set automatically when you connect a Vercel Blob store. Without it, data goes to ./.data/
BLOB_READ_WRITE_TOKEN=
# Optional: Claude API key for meal ideas (or add it in Admin → Settings)
ANTHROPIC_API_KEY=
# Optional: comma-separated emails that become admin on sign-up
ADMIN_EMAILS=
# Optional: set to false once everyone has joined to stop new sign-up requests
ALLOW_SIGNUPS=
# Optional: Claude idea requests per person per day (default 20)
IDEAS_DAILY_LIMIT=
# Daily reminder emails (see README → Reminders)
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_URL=
# Optional: post evening reminders to a Discord channel (or paste it in Admin → Settings)
DISCORD_WEBHOOK_URL=
